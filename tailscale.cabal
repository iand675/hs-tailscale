cabal-version:      2.4
name:               tailscale
version:            0.1.0.0
synopsis:           Haskell client for the Tailscale API
description:        A direct port of the official Tailscale Go SDK for Haskell.
                    Provides access to the Tailscale control plane API for managing
                    devices, DNS settings, ACLs, auth keys, and routes.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Ian Duncan
maintainer:         ian@iankduncan.com
category:           Network
build-type:         Simple
extra-doc-files:    README.md

library
  exposed-modules:
    Tailscale
    Tailscale.Client
    Tailscale.Types
    Tailscale.Device
    Tailscale.DNS
    Tailscale.Keys
    Tailscale.ACL
    Tailscale.Routes
    Tailscale.Tailnet

  build-depends:
    , aeson           >= 2.0    && < 2.3
    , base            >= 4.14   && < 5
    , bytestring      >= 0.10   && < 0.13
    , containers      >= 0.6    && < 0.8
    , http-client     >= 0.7    && < 0.8
    , http-client-tls >= 0.3    && < 0.4
    , http-types      >= 0.12   && < 0.13
    , text            >= 1.2    && < 2.2
    , time            >= 1.9    && < 1.15

  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall

source-repository head
  type:     git
  location: https://github.com/iand675/hs-tailscale.git
