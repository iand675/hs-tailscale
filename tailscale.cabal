cabal-version:      2.4
name:               tailscale
version:            0.1.0.0
synopsis:           Haskell client for the Tailscale API
description:        A comprehensive Haskell library for Tailscale, including:
                    .
                    * Control plane API for managing devices, DNS, ACLs, etc.
                    * LocalAPI for communicating with the local tailscaled daemon
                    * Pure Haskell embedded implementation (like Go's tsnet)
                    .
                    The embedded implementation includes WireGuard protocol,
                    DERP relay support, and control plane communication - all
                    in pure Haskell with no Go dependencies.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Ian Duncan
maintainer:         ian@iankduncan.com
category:           Network
build-type:         Simple
extra-doc-files:    README.md

library
  exposed-modules:
    -- Control Plane API (HTTP API for managing tailnets)
    Tailscale
    Tailscale.Client
    Tailscale.Types
    Tailscale.Device
    Tailscale.DNS
    Tailscale.Keys
    Tailscale.ACL
    Tailscale.Routes
    Tailscale.Tailnet

    -- LocalAPI (communication with local tailscaled daemon)
    Tailscale.LocalAPI
    Tailscale.LocalAPI.Types

    -- Server utilities (for running servers on Tailscale)
    Tailscale.Server

    -- Pure Haskell embedded Tailscale (like Go's tsnet)
    Tailscale.Embedded

    -- WireGuard protocol implementation
    Tailscale.WireGuard.Crypto
    Tailscale.WireGuard.Noise
    Tailscale.WireGuard.Protocol

    -- DERP relay protocol
    Tailscale.DERP.Protocol
    Tailscale.DERP.Client

    -- Control plane protocol
    Tailscale.Control.Protocol
    Tailscale.Control.Client

    -- Network utilities
    Tailscale.Network.Packet

  build-depends:
    , aeson           >= 2.0    && < 2.3
    , base            >= 4.14   && < 5
    , base64-bytestring >= 1.2 && < 1.3
    , bytestring      >= 0.10   && < 0.13
    , containers      >= 0.6    && < 0.8
    , crypton         >= 0.32   && < 1.1
    , directory       >= 1.3    && < 1.4
    , filepath        >= 1.4    && < 1.6
    , http-client     >= 0.7    && < 0.8
    , http-client-tls >= 0.3    && < 0.4
    , http-types      >= 0.12   && < 0.13
    , memory          >= 0.18   && < 0.19
    , network         >= 3.1    && < 3.3
    , stm             >= 2.5    && < 2.6
    , text            >= 1.2    && < 2.2
    , time            >= 1.9    && < 1.15
    , wireguard

  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall

test-suite tailscale-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:
    ClientSpec
    CryptoSpec
    TypesSpec
  hs-source-dirs:   test
  default-language: Haskell2010
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , base            >= 4.14 && < 5
    , base64-bytestring
    , bytestring
    , tailscale
    , tasty           >= 1.4  && < 1.6
    , tasty-hunit     >= 0.10 && < 0.11
    , text

source-repository head
  type:     git
  location: https://github.com/iand675/hs-tailscale.git
