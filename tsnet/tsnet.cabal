cabal-version:      2.4
name:               tsnet
version:            0.1.0.0
synopsis:           Pure Haskell embedded Tailscale networking
description:        A pure Haskell implementation of embedded Tailscale networking,
                    similar to Go's tsnet package. This allows Haskell applications
                    to join a Tailscale network without requiring the tailscaled daemon.
                    .
                    Features:
                    .
                    * Embedded Tailscale client that can be included in any Haskell application
                    * Control plane protocol for registration and network map updates
                    * DERP relay client for NAT traversal
                    * LocalAPI client for communicating with tailscaled
                    * Server utilities for building Tailscale-aware services
license:            BSD-3-Clause
license-file:       LICENSE
author:             Ian Duncan
maintainer:         ian@iankduncan.com
category:           Network
build-type:         Simple
extra-doc-files:    README.md

library
  exposed-modules:
    Tsnet
    Tsnet.Embedded
    Tsnet.Control.Protocol
    Tsnet.Control.Client
    Tsnet.DERP.Protocol
    Tsnet.DERP.Client
    Tsnet.Network.Packet
    Tsnet.LocalAPI
    Tsnet.LocalAPI.Types
    Tsnet.Server

  build-depends:
    , aeson           >= 2.0    && < 2.3
    , base            >= 4.14   && < 5
    , base64-bytestring >= 1.2 && < 1.3
    , bytestring      >= 0.10   && < 0.13
    , containers      >= 0.6    && < 0.8
    , crypton         >= 0.32   && < 1.1
    , directory       >= 1.3    && < 1.4
    , filepath        >= 1.4    && < 1.6
    , http-client     >= 0.7    && < 0.8
    , http-client-tls >= 0.3    && < 0.4
    , http-types      >= 0.12   && < 0.13
    , memory          >= 0.18   && < 0.19
    , network         >= 3.1    && < 3.3
    , stm             >= 2.5    && < 2.6
    , text            >= 1.2    && < 2.2
    , time            >= 1.9    && < 1.15
    , wireguard

  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall

source-repository head
  type:     git
  location: https://github.com/iand675/hs-tailscale.git
